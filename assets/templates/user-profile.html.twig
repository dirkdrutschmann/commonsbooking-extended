{% set required = required_fields ?? [] %}
{% set sms_configured = sms_configured ?? true %}
{% set show_phone_modal = sms_configured and (not data.phone_verified or not data.phone) and data.account_status != 'pending' and data.account_status != 'declined' %}
<div class="afcb-user-form afcb-tailwind" data-show-phone-modal="{{ show_phone_modal ? '1' : '0' }}">
    {% if show_phone_modal %}
    <div id="afcb-phone-verify-modal" class="afcb-modal-overlay fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 p-4" role="dialog" aria-labelledby="afcb-phone-modal-title" aria-modal="true">
        <div class="afcb-modal-content max-w-md w-full min-w-0 rounded-2xl bg-white shadow-xl p-6">
            <h2 id="afcb-phone-modal-title" class="text-xl font-semibold text-slate-800">Handynummer bestätigen</h2>
            <p class="mt-2 text-sm text-slate-600">Bestätige deine Telefonnummer, um alle Funktionen nutzen zu können. Deutsche Mobilnummern kannst du per SMS oder Signal bestätigen. Internationale Nummern bestätigst du per Signal oder über die manuelle Prüfung.</p>
            <div id="afcb-phone-modal-message" class="mt-4 hidden p-3 rounded-lg text-sm" role="alert"></div>
            <div class="mt-4 space-y-4">
                <div>
                    <label for="afcb-modal-phone" class="block text-sm font-medium text-slate-700">Deine Handynummer</label>
                    <form method="post" action="{{ action_url|e('html_attr') }}" id="afcb-send-code-form" class="mt-2 space-y-3">
                        <input type="hidden" name="action" value="afcb_send_phone_code">
                        {{ nonce_send_phone|raw }}
                        <input type="tel" id="afcb-modal-phone" name="phone" value="{{ data.phone|default('')|e('html_attr') }}" placeholder="z. B. +49 176 12345678" autocomplete="tel" class="afcb-phone-input w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
                        <div class="afcb-phone-channel-grid grid gap-2 text-sm text-slate-700 sm:grid-cols-2">
                            <label class="afcb-phone-channel-option afcb-phone-channel-sms flex min-w-0 items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2">
                                <input type="radio" name="phone_channel" value="sms" checked>
                                <span>SMS nutzen</span>
                            </label>
                            <label class="afcb-phone-channel-option flex min-w-0 items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2">
                                <input type="radio" name="phone_channel" value="signal">
                                <span>Signal nutzen</span>
                            </label>
                        </div>
                        <button type="submit" class="afcb-modal-action afcb-button afcb-button--secondary afcb-button--compact rounded-lg border border-slate-300 bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-200">Code anfordern</button>
                    </form>
                </div>
                <div>
                    <label for="afcb-modal-code" class="block text-sm font-medium text-slate-700">Code eingeben</label>
                    <form method="post" action="{{ action_url|e('html_attr') }}" id="afcb-verify-code-form" class="afcb-code-form mt-2 flex flex-wrap gap-2 items-end">
                        <input type="hidden" name="action" value="afcb_verify_phone_code">
                        {{ nonce_verify_phone|raw }}
                        <input type="text" id="afcb-modal-code" name="phone_code" placeholder="6-stelliger Code" maxlength="6" pattern="[0-9]{6}" class="rounded-lg border border-slate-300 px-3 py-2 text-sm w-32">
                        <button type="submit" class="afcb-modal-action afcb-button afcb-button--secondary afcb-button--compact rounded-lg border border-slate-300 bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-200">Bestätigen</button>
                    </form>
                </div>
                <div class="afcb-manual-phone-review-section rounded-xl border border-amber-200 bg-amber-50 p-4">
                    <h3 class="text-sm font-semibold text-slate-800">Manuelle Prüfung für internationale Nummern</h3>
                    <p class="mt-1 text-xs text-slate-600">Nutze das, wenn Signal nicht funktioniert oder du keinen Signal-Zugang hast.</p>
                    <form method="post" action="{{ action_url|e('html_attr') }}" id="afcb-manual-phone-review-form" class="mt-3 space-y-3">
                        <input type="hidden" name="action" value="afcb_request_manual_phone_verification">
                        {{ nonce_manual_phone_review|raw }}
                        <input type="tel" name="phone" value="{{ data.phone|default('')|e('html_attr') }}" placeholder="Telefonnummer mit Landesvorwahl" autocomplete="tel" class="afcb-phone-input w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
                        <textarea name="manual_review_note" rows="3" required class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" placeholder="Schreib kurz dazu, wie wir dich zur manuellen Prüfung erreichen können.">{{ data.manual_phone_review_note|default('')|e }}</textarea>
                        <button type="submit" class="afcb-modal-action afcb-button afcb-button--secondary afcb-button--compact rounded-lg border border-amber-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-amber-100">Manuelle Prüfung beantragen</button>
                    </form>
                </div>
            </div>
            <p class="mt-4 text-xs text-slate-500">Du kannst eine andere Nummer eintragen und dir den Code dorthin senden lassen. Internationale Nummern bitte mit Landesvorwahl eingeben.</p>
            <button type="button" class="afcb-modal-close mt-4 text-sm text-slate-500 hover:text-slate-700 underline">Später erledigen</button>
        </div>
    </div>
    {% endif %}
    <div class="afcb-profile-card max-w-4xl mx-auto bg-white border border-slate-200 rounded-2xl shadow-sm p-6 md:p-8">
        {% if notice %}
            {% include 'components/notice.html.twig' with {
                type: notice_type|default('info'),
                message: notice
            } only %}
        {% endif %}

        {% if data.account_status == 'pending' %}
            {% include 'components/notice.html.twig' with {
                type: 'warning',
                message: data.account_review_reason == 'foreign_phone_manual_verification'
                    ? 'Deine manuelle Telefonverifizierung wird geprüft. Diese Prüfung dauert in der Regel 1-2 Tage.'
                    : 'Dein Account wird geprüft, da es sich eventuell um eine Mehrfachanmeldung handelt. Diese Prüfung dauert in der Regel 1-2 Tage.'
            } only %}
        {% elseif data.account_status == 'declined' %}
            {% include 'components/notice.html.twig' with {
                type: 'error',
                message: 'Dein Account wurde abgelehnt. Bitte kontaktiere den Support.'
            } only %}
        {% endif %}

        {% if data.required_missing|length > 0 %}
            {% include 'components/notice.html.twig' with {
                type: 'warning',
                message: 'Bitte vervollständige die Pflichtfelder, um deinen Account vollständig freizuschalten.'
            } only %}
        {% endif %}

        <div class="afcb-profile-section-heading">
            <p class="afcb-profile-kicker">Konto &amp; Sicherheit</p>
            <h2 class="afcb-profile-section-title">Kontaktstatus</h2>
            <p class="afcb-profile-section-copy">Bestätigte Kontaktdaten sorgen dafür, dass dich wichtige Informationen zu deinen Buchungen sicher erreichen.</p>
        </div>

        <div class="afcb-profile-status-grid mt-6 grid gap-4 md:grid-cols-2">
            <div class="afcb-profile-status-card rounded-xl border border-slate-200 bg-slate-50 p-4">
                <h3 class="text-sm font-semibold text-slate-700">E-Mail</h3>
                {% if data.email_verified %}
                    <p class="mt-2 text-sm font-semibold text-emerald-600">Bestätigt</p>
                {% else %}
                    <p class="mt-2 text-sm font-semibold text-amber-600">Nicht bestätigt</p>
                    <form method="post" action="{{ action_url|e('html_attr') }}" class="mt-3">
                        <input type="hidden" name="action" value="afcb_resend_email_verification">
                        {{ nonce_resend_email|raw }}
                        {% include 'components/button.html.twig' with {
                            type: 'submit',
                            label: 'Bestätigungs-Mail senden',
                            class: 'afcb-button afcb-button--secondary afcb-button--compact rounded-md border border-slate-300 px-3 py-2 text-xs font-semibold text-slate-700'
                        } only %}
                    </form>
                {% endif %}
            </div>
            <div class="afcb-profile-status-card rounded-xl border border-slate-200 bg-slate-50 p-4">
                <h3 class="text-sm font-semibold text-slate-700">Telefon</h3>
                {% if data.phone_verified %}
                    <p class="mt-2 text-sm font-semibold text-emerald-600">Bestätigt</p>
                {% elseif sms_configured %}
                    <p class="mt-2 text-sm font-semibold text-amber-600">Nicht bestätigt</p>
                    {% if data.account_status == 'pending' and data.account_review_reason == 'foreign_phone_manual_verification' %}
                        <p class="mt-2 text-sm text-slate-600">Manuelle Telefonprüfung angefragt.</p>
                        {% if data.manual_phone_review_note %}
                            <p class="mt-2 text-xs text-slate-500">Deine Notiz: {{ data.manual_phone_review_note|e }}</p>
                        {% endif %}
                    {% else %}
                        <form method="post" action="{{ action_url|e('html_attr') }}" class="mt-3 flex flex-wrap gap-2">
                            <input type="hidden" name="action" value="afcb_send_phone_code">
                            {{ nonce_send_phone|raw }}
                            {% include 'components/button.html.twig' with {
                                type: 'submit',
                                name: 'phone_channel',
                                value: 'sms',
                                label: 'Per SMS',
                                class: 'afcb-button afcb-button--secondary afcb-button--compact rounded-md border border-slate-300 px-3 py-2 text-xs font-semibold text-slate-700'
                            } only %}
                            {% include 'components/button.html.twig' with {
                                type: 'submit',
                                name: 'phone_channel',
                                value: 'signal',
                                label: 'Per Signal',
                                class: 'afcb-button afcb-button--secondary afcb-button--compact rounded-md border border-slate-300 px-3 py-2 text-xs font-semibold text-slate-700'
                            } only %}
                        </form>
                        <form method="post" action="{{ action_url|e('html_attr') }}" class="mt-3 flex flex-wrap gap-2">
                            <input type="hidden" name="action" value="afcb_verify_phone_code">
                            {{ nonce_verify_phone|raw }}
                            {% include 'components/input.html.twig' with {
                                type: 'text',
                                name: 'phone_code',
                                class: 'rounded-md border border-slate-300 px-2 py-1 text-xs',
                                attrs: 'placeholder="6-stelliger Code" required'
                            } only %}
                            {% include 'components/button.html.twig' with {
                                type: 'submit',
                                label: 'Code prüfen',
                                class: 'afcb-button afcb-button--secondary afcb-button--compact rounded-md border border-slate-300 px-3 py-2 text-xs font-semibold text-slate-700'
                            } only %}
                        </form>
                        {% if data.phone_requires_manual_review %}
                            <form method="post" action="{{ action_url|e('html_attr') }}" class="mt-3 space-y-2">
                                <input type="hidden" name="action" value="afcb_request_manual_phone_verification">
                                {{ nonce_manual_phone_review|raw }}
                                <textarea name="manual_review_note" rows="3" required class="w-full rounded-md border border-slate-300 px-3 py-2 text-xs" placeholder="Hinweis für die manuelle Prüfung">{{ data.manual_phone_review_note|default('')|e }}</textarea>
                                {% include 'components/button.html.twig' with {
                                    type: 'submit',
                                    label: 'Manuelle Prüfung beantragen',
                                    class: 'afcb-button afcb-button--secondary afcb-button--compact rounded-md border border-amber-300 px-3 py-2 text-xs font-semibold text-slate-700'
                                } only %}
                            </form>
                        {% endif %}
                    {% endif %}
                {% else %}
                    <p class="mt-2 text-sm text-slate-600">Telefonnummer wird ohne Nachrichten-Verifizierung gespeichert.</p>
                {% endif %}
            </div>
        </div>

        <form method="post" action="{{ action_url|e('html_attr') }}" class="afcb-form afcb-profile-form mt-6 space-y-6">
            <input type="hidden" name="action" value="afcb_profile_update">
            {{ nonce_profile|raw }}

            <div class="afcb-profile-section-heading">
                <p class="afcb-profile-kicker">Persönliche Angaben</p>
                <h2 class="afcb-profile-section-title">Profildaten</h2>
                <p class="afcb-profile-section-copy">Halte deine Kontakt- und Adressdaten aktuell, damit deine Ausleihe reibungslos vorbereitet werden kann.</p>
            </div>

            <div class="afcb-profile-fields space-y-4">
                {% set username_control %}
                    {% include 'components/input.html.twig' with {
                        type: 'text',
                        id: 'user_login',
                        value: data.user_login|default(''),
                        class: 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-slate-100',
                        attrs: 'disabled'
                    } only %}
                {% endset %}
                {% include 'components/field.html.twig' with {
                    label: 'Benutzername',
                    id: 'user_login',
                    control: username_control
                } only %}

                {% set email_required = 'user_email' in required %}
                {% set email_control %}
                    {% include 'components/input.html.twig' with {
                        type: 'email',
                        id: 'user_email',
                        name: 'user_email',
                        value: data.user_email|default(''),
                        class: 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm',
                        attrs: email_required ? 'required' : ''
                    } only %}
                {% endset %}
                {% include 'components/field.html.twig' with {
                    label: 'E-Mail' ~ (email_required ? ' *' : ''),
                    id: 'user_email',
                    control: email_control
                } only %}

                {% set first_required = 'first_name' in required %}
                {% set first_control %}
                    {% include 'components/input.html.twig' with {
                        type: 'text',
                        id: 'first_name',
                        name: 'first_name',
                        value: data.first_name|default(''),
                        class: 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm',
                        attrs: first_required ? 'required' : ''
                    } only %}
                {% endset %}
                {% include 'components/field.html.twig' with {
                    label: 'Vorname' ~ (first_required ? ' *' : ''),
                    id: 'first_name',
                    control: first_control
                } only %}

                {% set last_required = 'last_name' in required %}
                {% set last_control %}
                    {% include 'components/input.html.twig' with {
                        type: 'text',
                        id: 'last_name',
                        name: 'last_name',
                        value: data.last_name|default(''),
                        class: 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm',
                        attrs: last_required ? 'required' : ''
                    } only %}
                {% endset %}
                {% include 'components/field.html.twig' with {
                    label: 'Nachname' ~ (last_required ? ' *' : ''),
                    id: 'last_name',
                    control: last_control
                } only %}

                {% set phone_required = 'afcb_phone' in required %}
                {% set phone_control %}
                    {% include 'components/input.html.twig' with {
                        type: 'tel',
                        id: 'phone',
                        name: 'phone',
                        value: data.phone|default(''),
                        class: 'afcb-phone-input w-full rounded-lg border border-slate-300 px-3 py-2 text-sm',
                        attrs: 'autocomplete="tel" placeholder="z. B. +49 176 12345678"' ~ (phone_required ? ' required' : '')
                    } only %}
                {% endset %}
                {% include 'components/field.html.twig' with {
                    label: 'Telefon' ~ (phone_required ? ' *' : ''),
                    id: 'phone',
                    control: phone_control
                } only %}
                <div class="afcb-address afcb-profile-address space-y-2">
                    {% set street_required = 'afcb_street' in required %}
                    {% set house_number_required = 'afcb_house_number' in required %}
                    {% set zip_required = 'afcb_zip' in required %}
                    {% set city_required = 'afcb_city' in required %}
                    {% set address_control %}
                        {% include 'components/input.html.twig' with {
                            type: 'text',
                            id: 'address_search',
                            name: 'address_search',
                            class: 'afcb-address-search w-full rounded-lg border border-slate-300 px-3 py-2 text-sm',
                            attrs: 'placeholder="Straße Hausnummer, PLZ Ort" autocomplete="street-address"'
                        } only %}
                    {% endset %}
                    {% include 'components/field.html.twig' with {
                        label: 'Adresse suchen',
                        id: 'address_search',
                        control: address_control
                    } only %}
                    <div class="afcb-address-results rounded-lg border border-slate-200 bg-white shadow-sm"></div>
                    <p class="text-xs text-slate-500">Wähle einen Suchtreffer aus oder trage die Adresse vollständig ein.</p>
                    <div class="grid gap-3 md:grid-cols-6">
                        <div class="md:col-span-4 space-y-1">
                            <label for="street" class="block text-sm font-medium text-slate-700">Straße{{ street_required ? ' *' : '' }}</label>
                            {% include 'components/input.html.twig' with {
                                type: 'text',
                                id: 'street',
                                name: 'street',
                                value: data.street|default(''),
                                class: 'afcb-address-detail w-full rounded-lg border border-slate-300 px-3 py-2 text-sm',
                                attrs: 'autocomplete="address-line1"' ~ (street_required ? ' required' : '')
                            } only %}
                        </div>
                        <div class="md:col-span-2 space-y-1">
                            <label for="house_number" class="block text-sm font-medium text-slate-700">Hausnummer{{ house_number_required ? ' *' : '' }}</label>
                            {% include 'components/input.html.twig' with {
                                type: 'text',
                                id: 'house_number',
                                name: 'house_number',
                                value: data.house_number|default(''),
                                class: 'afcb-address-detail w-full rounded-lg border border-slate-300 px-3 py-2 text-sm',
                                attrs: house_number_required ? 'required' : ''
                            } only %}
                        </div>
                        <div class="md:col-span-2 space-y-1">
                            <label for="zip" class="block text-sm font-medium text-slate-700">PLZ{{ zip_required ? ' *' : '' }}</label>
                            {% include 'components/input.html.twig' with {
                                type: 'text',
                                id: 'zip',
                                name: 'zip',
                                value: data.zip|default(''),
                                class: 'afcb-address-detail w-full rounded-lg border border-slate-300 px-3 py-2 text-sm',
                                attrs: 'autocomplete="postal-code"' ~ (zip_required ? ' required' : '')
                            } only %}
                        </div>
                        <div class="md:col-span-4 space-y-1">
                            <label for="city" class="block text-sm font-medium text-slate-700">Ort{{ city_required ? ' *' : '' }}</label>
                            {% include 'components/input.html.twig' with {
                                type: 'text',
                                id: 'city',
                                name: 'city',
                                value: data.city|default(''),
                                class: 'afcb-address-detail w-full rounded-lg border border-slate-300 px-3 py-2 text-sm',
                                attrs: 'autocomplete="address-level2"' ~ (city_required ? ' required' : '')
                            } only %}
                        </div>
                    </div>
                    {% if data.street or data.zip or data.city %}
                        <div class="text-sm text-slate-600">
                            Aktuelle Adresse: {{ data.street|e }} {{ data.house_number|e }}, {{ data.zip|e }} {{ data.city|e }}{% if data.country %}, {{ data.country|e }}{% endif %}
                        </div>
                    {% endif %}
                </div>
            </div>

            {% if custom_fields is not empty %}
                <div class="space-y-4">
                    {% for field in custom_fields %}
                        {% set field_id = 'custom_' ~ field.key %}
                        {% set label_text = field.label ~ (field.required ? ' *' : '') %}
                        {% set field_required_attr = field.required ? 'required' : '' %}

                        {% if field.type == 'textarea' %}
                            {% set custom_control %}
                                {% include 'components/textarea.html.twig' with {
                                    id: field_id,
                                    name: 'custom_fields[' ~ field.key ~ ']',
                                    value: field.value|default(''),
                                    class: 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm',
                                    attrs: field_required_attr
                                } only %}
                            {% endset %}
                        {% elseif field.type == 'select' %}
                            {% set options = [] %}
                            {% for option in field.options %}
                                {% set options = options|merge([{ value: option, label: option, selected: option == field.value }]) %}
                            {% endfor %}
                            {% set custom_control %}
                                {% include 'components/select.html.twig' with {
                                    id: field_id,
                                    name: 'custom_fields[' ~ field.key ~ ']',
                                    class: 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm',
                                    placeholder: 'Bitte wählen',
                                    options: options,
                                    attrs: field_required_attr
                                } only %}
                            {% endset %}
                        {% else %}
                            {% set input_type = field.type == 'date' ? 'date' : (field.type == 'number' ? 'number' : 'text') %}
                            {% set custom_control %}
                                {% include 'components/input.html.twig' with {
                                    type: input_type,
                                    id: field_id,
                                    name: 'custom_fields[' ~ field.key ~ ']',
                                    value: field.value|default(''),
                                    class: 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm',
                                    attrs: field_required_attr
                                } only %}
                            {% endset %}
                        {% endif %}

                        {% include 'components/field.html.twig' with {
                            label: label_text,
                            id: field_id,
                            control: custom_control
                        } only %}
                    {% endfor %}
                </div>
            {% endif %}

            <input type="hidden" name="state" value="{{ data.state|e('html_attr') }}">
            <input type="hidden" name="country" value="{{ data.country|e('html_attr') }}">
            <input type="hidden" name="address_lat" class="afcb-address-lat" value="{{ data.address_lat|e('html_attr') }}">
            <input type="hidden" name="address_lon" class="afcb-address-lon" value="{{ data.address_lon|e('html_attr') }}">
            <input type="hidden" name="address_raw" class="afcb-address-raw" value="{{ data.address_raw|e('html_attr') }}">

            <div class="afcb-profile-form-footer">
                <p>Mit * markierte Felder sind Pflichtfelder.</p>
                {% include 'components/button.html.twig' with {
                    type: 'submit',
                    label: 'Profil speichern',
                    class: 'afcb-button afcb-button--primary w-full rounded-lg bg-teal-600 px-4 py-3 text-sm font-semibold text-white hover:bg-teal-700'
                } only %}
            </div>
        </form>

        <div class="afcb-profile-danger mt-8 border-t border-rose-100 pt-6">
            <h2 class="text-lg font-semibold text-rose-700">Profil löschen</h2>
            <p class="mt-2 text-sm text-slate-600">Du erhältst zuerst eine E-Mail mit einem Bestätigungslink. Erst danach wird dein Profil dauerhaft entfernt und alle zugehörigen Buchungen werden storniert.</p>
            <form method="post" action="{{ action_url|e('html_attr') }}" class="afcb-profile-danger-form mt-4 space-y-4">
                <input type="hidden" name="action" value="afcb_request_profile_deletion">
                {{ nonce_delete_profile|raw }}
                <label class="afcb-profile-danger-confirm flex items-start gap-3 text-sm text-slate-700">
                    <input type="checkbox" name="delete_profile_confirm" value="1" required class="mt-1 h-4 w-4 rounded border-slate-300">
                    <span>Ich möchte die Profil-Löschung per E-Mail bestätigen.</span>
                </label>
                {% include 'components/button.html.twig' with {
                    type: 'submit',
                    label: 'Löschung per E-Mail anfordern',
                    class: 'afcb-button afcb-button--danger rounded-lg bg-rose-600 px-4 py-3 text-sm font-semibold text-white hover:bg-rose-700'
                } only %}
            </form>
        </div>
    </div>
</div>
