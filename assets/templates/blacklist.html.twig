		<div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
			<form id="timeframe" method="post" action="{{ admin_post_url|e('html_attr') }}">
				<h2 class="text-lg font-semibold text-slate-800">Buchungsbeschränkung</h2>

				<p class="mt-3 text-sm text-slate-600">
					Hier werden Regeln für Buchungsbeschränkungen gepflegt.
				</p>

				<div class="mt-4 space-y-4">
					{{ field | raw }}
					{{ section | raw }}
					{{ button | raw }}
				</div>
			</form>
		</div>
	</div>
</div>
