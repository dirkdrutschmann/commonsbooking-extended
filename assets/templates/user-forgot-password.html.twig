<div class="afcb-user-form afcb-tailwind">
    <div class="max-w-xl mx-auto bg-white border border-slate-200 rounded-2xl shadow-sm p-6 md:p-8">
        {% if notice %}
            {% include 'components/notice.html.twig' with {
                type: notice_type|default('info'),
                message: notice
            } only %}
        {% endif %}

        {% if is_reset %}
            <form method="post" action="{{ action_url|e('html_attr') }}" class="afcb-form mt-6 space-y-4">
                <input type="hidden" name="action" value="afcb_reset_password">
                <input type="hidden" name="reset_key" value="{{ reset_key|e('html_attr') }}">
                <input type="hidden" name="reset_login" value="{{ reset_login|e('html_attr') }}">
                {{ reset_nonce_field|raw }}

                {% set password_control %}
                    {% include 'components/input.html.twig' with {
                        type: 'password',
                        name: 'user_pass',
                        class: 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm',
                        attrs: 'required autocomplete="new-password"'
                    } only %}
                {% endset %}
                {% include 'components/field.html.twig' with {
                    label: 'Neues Passwort',
                    control: password_control
                } only %}

                {% set password_confirm_control %}
                    {% include 'components/input.html.twig' with {
                        type: 'password',
                        name: 'user_pass_confirm',
                        class: 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm',
                        attrs: 'required autocomplete="new-password"'
                    } only %}
                {% endset %}
                {% include 'components/field.html.twig' with {
                    label: 'Neues Passwort wiederholen',
                    control: password_confirm_control
                } only %}

                {% include 'components/button.html.twig' with {
                    type: 'submit',
                    label: 'Passwort speichern',
                    class: 'w-full rounded-lg bg-slate-800 px-4 py-3 text-sm font-semibold text-white hover:bg-slate-900'
                } only %}
            </form>
        {% else %}
            <form method="post" action="{{ action_url|e('html_attr') }}" class="afcb-form mt-6 space-y-4">
                <input type="hidden" name="action" value="afcb_forgot_password">
                {{ nonce_field|raw }}

                {% set login_control %}
                    {% include 'components/input.html.twig' with {
                        type: 'text',
                        name: 'user_login',
                        class: 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm',
                        attrs: 'required'
                    } only %}
                {% endset %}
                {% include 'components/field.html.twig' with {
                    label: 'Benutzername oder E-Mail',
                    control: login_control
                } only %}

                {% if recaptcha_site_key and recaptcha_version == 'v2' %}
                    <div class="afcb-recaptcha">
                        <div class="g-recaptcha" data-sitekey="{{ recaptcha_site_key|e('html_attr') }}"></div>
                    </div>
                {% endif %}

                {% include 'components/button.html.twig' with {
                    type: 'submit',
                    label: 'Link senden',
                    class: 'w-full rounded-lg bg-slate-800 px-4 py-3 text-sm font-semibold text-white hover:bg-slate-900'
                } only %}
            </form>
        {% endif %}

        {% if login_url %}
            <div class="mt-6 text-sm">
                <a class="text-teal-600 hover:text-teal-700" href="{{ login_url|e('html_attr') }}">Zur Anmeldung</a>
            </div>
        {% endif %}
    </div>
</div>
