<div class="wrap afcb-admin-tailwind">
    <div class="max-w-4xl">
        <h1 class="text-2xl font-semibold text-slate-800">{{ title|e }}</h1>
        <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <form method="post" action="{{ action_url|e('html_attr') }}" class="space-y-6">
                {{ settings_fields|raw }}

                <h2 class="text-lg font-semibold text-slate-800">{{ subtitle|e }}</h2>
                <div class="mt-4 space-y-4">
                    {% for field in fields %}
                        {% if field.type == 'textarea' %}
                            {% set control %}
                                {% include 'components/textarea.html.twig' with {
                                    name: field.name,
                                    id: field.key,
                                    value: field.value,
                                    rows: 5,
                                    class: 'w-full rounded-md border border-slate-300 px-3 py-2 text-sm'
                                } %}
                            {% endset %}
                        {% elseif field.type == 'select' %}
                            {% set control %}
                                {% include 'components/select.html.twig' with {
                                    name: field.name,
                                    id: field.key,
                                    options: field.options,
                                    class: 'w-full max-w-md rounded-md border border-slate-300 px-3 py-2 text-sm'
                                } %}
                            {% endset %}
                        {% else %}
                            {% set control %}
                                {% include 'components/input.html.twig' with {
                                    name: field.name,
                                    id: field.key,
                                    value: field.value,
                                    class: 'w-full max-w-md rounded-md border border-slate-300 px-3 py-2 text-sm'
                                } %}
                            {% endset %}
                        {% endif %}

                        {% include 'components/field.html.twig' with {
                            label: field.label,
                            id: field.key,
                            control: control,
                            help: field.help
                        } %}
                    {% endfor %}
                </div>

                {% include 'components/button.html.twig' with {
                    type: 'submit',
                    label: 'Speichern'
                } %}
            </form>
        </div>
    </div>
</div>
