<div class="wrap afcb-admin-tailwind">
    <div class="max-w-4xl">
        <h1 class="text-2xl font-semibold text-slate-800">{{ page_title|e }}</h1>

        {% set form_content %}
            <form class="cb-resender-form mt-4 space-y-4" data-resend-type="post_id">
                {{ nonce_field|raw }}

                {% set input_control %}
                    {% include 'components/input.html.twig' with {
                        type: 'number',
                        id: 'post_id',
                        name: 'post_id',
                        class: 'w-full max-w-xs rounded-md border border-slate-300 px-3 py-2 text-sm',
                        attrs: 'placeholder="' ~ field_placeholder|e('html_attr') ~ '" min="1"'
                    } only %}
                {% endset %}
                {% include 'components/field.html.twig' with {
                    label: field_label,
                    id: 'post_id',
                    help: field_help,
                    control: input_control
                } only %}

                {% include 'components/button.html.twig' with {
                    type: 'submit',
                    label: submit_label,
                    class: 'inline-flex items-center rounded-md bg-slate-800 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-900'
                } only %}
            </form>
        {% endset %}
        {% include 'components/card.html.twig' with {
            title: form_title,
            subtitle: form_subtitle,
            content: form_content
        } only %}

        {% set range_content %}
            <form class="cb-resender-form mt-4 space-y-4" data-resend-type="date_range">
                {{ nonce_field|raw }}

                {% set date_control %}
                    {% include 'components/input.html.twig' with {
                        type: 'text',
                        id: 'start_date',
                        name: 'start_date',
                        class: 'cb-resender-date w-full max-w-xs rounded-md border border-slate-300 px-3 py-2 text-sm',
                        attrs: 'placeholder="' ~ date_placeholder|e('html_attr') ~ '" autocomplete="off"'
                    } only %}
                {% endset %}
                {% include 'components/field.html.twig' with {
                    label: date_label,
                    id: 'start_date',
                    help: date_help,
                    control: date_control
                } only %}

                {% set status_control %}
                    {% include 'components/select.html.twig' with {
                        id: 'booking_status',
                        name: 'booking_status',
                        class: 'w-full max-w-xs rounded-md border border-slate-300 px-3 py-2 text-sm',
                        options: status_options
                    } only %}
                {% endset %}
                {% include 'components/field.html.twig' with {
                    label: status_label,
                    id: 'booking_status',
                    help: status_help,
                    control: status_control
                } only %}

                {% set batch_control %}
                    {% include 'components/select.html.twig' with {
                        id: 'batch_size',
                        name: 'batch_size',
                        class: 'w-full max-w-xs rounded-md border border-slate-300 px-3 py-2 text-sm',
                        options: batch_options
                    } only %}
                {% endset %}
                {% include 'components/field.html.twig' with {
                    label: batch_label,
                    id: 'batch_size',
                    help: batch_help,
                    control: batch_control
                } only %}

                <label class="flex items-center gap-2 text-sm text-slate-700">
                    {% include 'components/checkbox.html.twig' with {
                        name: 'preview_mode',
                        id: 'preview_mode',
                        class: 'h-4 w-4 rounded border-slate-300 text-teal-600'
                    } only %}
                    <span>{{ preview_label|e }}</span>
                </label>
                {% if preview_help %}
                    <p class="text-xs text-slate-500">{{ preview_help|e }}</p>
                {% endif %}

                {% include 'components/button.html.twig' with {
                    type: 'submit',
                    label: range_submit_label,
                    class: 'inline-flex items-center rounded-md bg-teal-600 px-4 py-2 text-sm font-semibold text-white hover:bg-teal-700'
                } only %}
            </form>
        {% endset %}
        {% include 'components/card.html.twig' with {
            title: range_title,
            subtitle: range_subtitle,
            content: range_content,
            class: 'mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm'
        } only %}

        <div id="cb-loading" class="mt-6 hidden">
            {% set loading_content %}
                <p class="text-sm text-slate-600">{{ loading_text|e }}</p>
                <div class="mt-4 h-2 w-full rounded-full bg-slate-100">
                    <div class="h-2 w-0 rounded-full bg-teal-600 transition-all" id="cb-progress-fill"></div>
                </div>
                <div id="cb-progress-text" class="mt-2 text-xs text-slate-500">0%</div>
            {% endset %}
            {% include 'components/card.html.twig' with {
                title: loading_title,
                content: loading_content
            } only %}
        </div>

        <div id="cb-results" class="mt-6 hidden">
            {% set results_content %}
                <div id="cb-results-content" class="mt-3 space-y-2 text-sm text-slate-700"></div>
            {% endset %}
            {% include 'components/card.html.twig' with {
                title: results_title,
                content: results_content
            } only %}
        </div>
    </div>
</div>
