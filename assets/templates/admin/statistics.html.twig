<div class="wrap afcb-admin-tailwind">
    <div class="max-w-6xl">
        <h1 class="text-2xl font-semibold text-slate-800">Statistik</h1>
        <p class="mt-2 text-sm text-slate-600">
            Hier gibt es die Statistik. Der Download dauert circa eine Minute. Bitte warten. Bereinigte Nutzerdaten bedeutet:
            Nutzer, die sich innerhalb der letzten 2 Jahre eingeloggt haben.
        </p>
        <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex flex-wrap items-center justify-between gap-4">
                <div>
                    <h2 class="text-lg font-semibold text-slate-800">Benutzer-Statistik</h2>
                    <p class="mt-1 text-sm text-slate-600">Zuletzt aktualisiert: {{ generated_at|e }}</p>
                </div>
                {% include 'components/button.html.twig' with {
                    type: 'button',
                    label: 'Aktualisieren',
                    class: 'inline-flex items-center rounded-md bg-slate-800 px-3 py-2 text-sm font-semibold text-white hover:bg-slate-900',
                    attrs: "onclick=\"window.location.href='" ~ refresh_url|e('html_attr') ~ "'\""
                } %}
            </div>

            <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
                    <h3 class="text-sm font-semibold text-slate-600">Benutzer gesamt</h3>
                    <div class="mt-2 text-2xl font-bold text-slate-900">{{ stats.total_users|default(0)|number_format(0, ',', '.') }}</div>
                </div>
                <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
                    <h3 class="text-sm font-semibold text-slate-600">Registrierungen</h3>
                    <div class="mt-2 space-y-1 text-sm text-slate-600">
                        <div>Heute: {{ stats.registrations.today|default(0) }}</div>
                        <div>Diese Woche: {{ stats.registrations.week|default(0) }}</div>
                        <div>Diesen Monat: {{ stats.registrations.month|default(0) }}</div>
                        <div>Dieses Jahr: {{ stats.registrations.year|default(0) }}</div>
                        <div>Letzte 7 Tage: {{ stats.registrations.last_7_days|default(0) }}</div>
                        <div>Letzte 30 Tage: {{ stats.registrations.last_30_days|default(0) }}</div>
                    </div>
                </div>
                <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
                    <h3 class="text-sm font-semibold text-slate-600">Aktivität (Login)</h3>
                    <div class="mt-2 space-y-1 text-sm text-slate-600">
                        <div>Heute: {{ stats.activity.today|default(0) }}</div>
                        <div>Diese Woche: {{ stats.activity.week|default(0) }}</div>
                        <div>Diesen Monat: {{ stats.activity.month|default(0) }}</div>
                        <div>Letzte 7 Tage: {{ stats.activity.last_7_days|default(0) }}</div>
                        <div>Letzte 30 Tage: {{ stats.activity.last_30_days|default(0) }}</div>
                    </div>
                </div>
                <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
                    <h3 class="text-sm font-semibold text-slate-600">Verifikation</h3>
                    <div class="mt-2 space-y-1 text-sm text-slate-600">
                        <div>E-Mail bestätigt: {{ stats.verification.email_verified|default(0) }}</div>
                        <div>Telefon bestätigt: {{ stats.verification.phone_verified|default(0) }}</div>
                        <div>Vollständig authentifiziert: {{ stats.verification.fully_authenticated|default(0) }}</div>
                        <div>Pflichtfelder fehlen: {{ stats.verification.missing_required|default(0) }}</div>
                    </div>
                </div>
                <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
                    <h3 class="text-sm font-semibold text-slate-600">Status</h3>
                    <div class="mt-2 space-y-1 text-sm text-slate-600">
                        <div>Prüfung offen: {{ stats.status.pending|default(0) }}</div>
                        <div>Abgelehnt: {{ stats.status.declined|default(0) }}</div>
                    </div>
                </div>
                <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
                    <h3 class="text-sm font-semibold text-slate-600">Login-Status</h3>
                    <div class="mt-2 space-y-1 text-sm text-slate-600">
                        <div>Nie eingeloggt: {{ stats.login.never_logged_in|default(0) }}</div>
                        <div>Inaktiv &gt; 90 Tage: {{ stats.login.inactive_90_days|default(0) }}</div>
                    </div>
                </div>
            </div>

            <form method="post" action="" class="mt-6">
                {% include 'components/button.html.twig' with {
                    type: 'submit',
                    name: 'generate_excel',
                    value: '1',
                    label: 'Excel downloaden',
                    class: 'inline-flex items-center rounded-md bg-teal-600 px-4 py-2 text-sm font-semibold text-white hover:bg-teal-700'
                } %}
            </form>
        </div>
    </div>
</div>
