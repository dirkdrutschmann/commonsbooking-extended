<div class="wrap afcb-admin-tailwind">
    <div class="max-w-2xl">
        <h1 class="text-2xl font-semibold text-slate-800">Deinstallation</h1>
        {% if afcb_error %}
            <div class="mt-4">
                {% include 'components/notice.html.twig' with { type: 'error', message: 'Ungültige Anfrage.', strong: true } %}
            </div>
        {% endif %}
        <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <p class="text-slate-700">Wenn Sie das Plugin löschen möchten, gehen Sie nach dem Klick auf „Weiter zur Plugin-Seite“ zu <strong>Plugins</strong> und löschen das Plugin dort. Beim Löschen wird folgende Einstellung berücksichtigt:</p>
            <form class="mt-6" method="post" action="{{ admin_post_url|e('html_attr') }}">
                <input type="hidden" name="action" value="afcb_prepare_uninstall">
                <input type="hidden" name="afcb_prepare_uninstall_nonce" value="{{ prepare_nonce|e('html_attr') }}">
                <fieldset class="space-y-3">
                    <legend class="text-sm font-semibold text-slate-800">Soll beim Löschen des Plugins die Benutzermetadaten (User-Management-Daten) bereinigt werden?</legend>
                    <label class="flex items-center gap-2">
                        <input type="radio" name="afcb_uninstall_cleanup" value="0" checked class="rounded-full border-slate-300">
                        <span class="text-slate-700">Nein (Standard) – Metadaten bleiben erhalten</span>
                    </label>
                    <label class="flex items-center gap-2">
                        <input type="radio" name="afcb_uninstall_cleanup" value="1" class="rounded-full border-slate-300">
                        <span class="text-slate-700">Ja – Benutzermetadaten löschen</span>
                    </label>
                </fieldset>
                <p class="mt-4">
                    {% include 'components/button.html.twig' with {
                        type: 'submit',
                        label: 'Weiter zur Plugin-Seite',
                        class: 'px-4 py-2 rounded-md bg-slate-800 text-white text-sm font-semibold'
                    } %}
                </p>
            </form>
        </div>
    </div>
</div>
