<div class="cb-qr-check cb-qr-check--invalid">
    <header class="cb-qr-hero cb-qr-status--invalid">
        <div class="cb-qr-hero__icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 7 10 10M17 7 7 17"></path></svg>
        </div>
        <div class="cb-qr-hero__content">
            <p class="cb-qr-eyebrow">{{ eyebrow|e }}</p>
            <h2>{{ status_label|e }}</h2>
            <p class="cb-qr-description">{{ description|e }}</p>
        </div>
    </header>

    <div class="cb-qr-hint">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 8v5m0 3.5v.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path></svg>
        <p>{{ hint|e }}</p>
    </div>
</div>
