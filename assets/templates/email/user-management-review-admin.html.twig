<p style="margin:0 0 6px;color:#008f6b;font-size:13px;font-weight:bold;text-transform:uppercase;">Manuelle Prüfung</p>
<h2 style="margin:0 0 14px;color:#183e30;font-size:22px;line-height:1.25;">Account prüfen und freischalten</h2>
<p style="margin:0 0 18px;">Ein Benutzerkonto benötigt eine manuelle Prüfung.</p>

<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;margin:22px 0;border:1px solid #dbe8e2;border-radius:6px;overflow:hidden;">
    <tr>
        <td style="padding:10px 12px;background:#f3f7f4;color:#5f746b;font-size:13px;width:38%;">Benutzer</td>
        <td style="padding:10px 12px;color:#183e30;font-size:14px;"><strong>{{user_login}}</strong></td>
    </tr>
    <tr>
        <td style="padding:10px 12px;background:#f3f7f4;color:#5f746b;font-size:13px;">E-Mail</td>
        <td style="padding:10px 12px;color:#183e30;font-size:14px;">{{user_email}}</td>
    </tr>
    <tr>
        <td style="padding:10px 12px;background:#f3f7f4;color:#5f746b;font-size:13px;">Grund</td>
        <td style="padding:10px 12px;color:#183e30;font-size:14px;">{{review_reason}}</td>
    </tr>
</table>

<div style="margin:22px 0;padding:16px 18px;background:#f8faf9;border:1px solid #dbe8e2;border-radius:6px;">
    <p style="margin:0 0 8px;font-weight:bold;color:#183e30;">Hinweise und Treffer</p>
    <div style="color:#243b35;">{{match_list}}</div>
</div>

<p style="margin:28px 0 0;"><a href="{{review_url}}" style="display:inline-block;background:#008f6b;color:#ffffff;padding:12px 18px;border-radius:6px;text-decoration:none;font-weight:bold;">Account prüfen</a></p>
