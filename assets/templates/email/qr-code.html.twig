<div class="cb-qr-code-wrapper" style="margin-top: 20px; text-align: center;">
    <h3>{{ title|e }}</h3>
    <div style="text-align: center; margin: 20px 0;">
        <img src="{{ qr_url|e('html_attr') }}" alt="{{ alt_text|e('html_attr') }}" style="max-width: {{ qr_size|e('html_attr') }}px; height: auto; border: 2px solid #ddd; padding: 10px; background: white;" />
    </div>
    <p style="font-size: 12px; color: #666;">{{ description|e }}</p>
</div>
