{% set type = type|default('button') %}
{% set class = class|default('inline-flex items-center rounded-md bg-slate-800 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-900') %}
<button
    type="{{ type|e('html_attr') }}"
    {% if name is defined %}name="{{ name|e('html_attr') }}"{% endif %}
    {% if value is defined %}value="{{ value|e('html_attr') }}"{% endif %}
    {% if id is defined %}id="{{ id|e('html_attr') }}"{% endif %}
    class="{{ class|e('html_attr') }}"
    {% if attrs is defined %}{{ attrs|raw }}{% endif %}
>
    {% if label_html is defined %}
        {{ label_html|raw }}
    {% elseif label is defined %}
        {{ label|e }}
    {% endif %}
</button>
